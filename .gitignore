.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
dist/
build/
runs/

# Model checkpoints, temporary/transactional writes, and logs
*.pt
*.pt.sha256
*.ckpt
*.tmp
*.tmp-*
*.log

# Generated datasets and large numerical artifacts
data/
datasets/
*.npy
*.npz
*.parquet
*.arrow

# SQLite transient state
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db-wal
*.db-shm
*.db-journal

# Keep only immutable/auditable manifests under the generated-artifact tree.
artifacts/*
!artifacts/manifest.json
!artifacts/pilot_manifest.json
!artifacts/learnability_audit_manifest.json
!artifacts/mechanism_isolation_manifest.json
!artifacts/production_suspension_status.json
!artifacts/checkpoint_gradient_dynamics_audit.json
!artifacts/parent_pair_split.json
!artifacts/compositional_generalization_manifest.json
!artifacts/v3_4_freeze_record.json
